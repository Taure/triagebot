[
    {nova, [
        {cowboy_configuration, #{
            port => 8080
        }},
        {use_strict_routing, true},
        {environment, dev}
    ]},
    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                formatter => {logger_formatter, #{single_line => true}}
            }}
        ]}
    ]}
].

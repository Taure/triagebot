[
    {kernel, [
        {logger_level, debug},
        {logger, [
            {handler, default, logger_std_h, #{
                formatter => {nova_jsonlogger, #{
                    map_depth => 3,
                    term_depth => 50
                }}
            }}
        ]}
    ]},
    {nova, [
        {environment, dev},
        {use_stacktrace, true},
        {dev_mode, true},
        {cowboy_configuration, #{
            port => 8080
        }},
        {bootstrap_application, triagebot},
        {json_lib, json}
    ]},
    {triagebot, [
        {nova_apps, []}
    ]}
].

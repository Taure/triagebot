[
    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                formatter => {nova_jsonlogger, #{
                    map_depth => 3,
                    term_depth => 50
                }}
            }}
        ]}
    ]},
    {nova, [
        {environment, prod},
        {cowboy_configuration, #{
            port => 8080,
            ip => {0, 0, 0, 0}
        }},
        {bootstrap_application, triagebot},
        {json_lib, json}
    ]},
    {triagebot, [
        {nova_apps, []}
    ]}
].

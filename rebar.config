{erl_opts, [debug_info, warnings_as_errors]}.
{src_dirs, [{"src", [{recursive, true}]}]}.
{shell, [{config, "./config/dev_sys.config.src"}]}.

{deps, [
    %% Nova fork carrying nova_jsonlogger tier1 (novaframework/nova#385); pinned
    %% to a SHA since Nova is pre-release. Swap to a tag once #385 lands + ships.
    {nova,
        {git, "https://github.com/Taure/nova.git",
            {ref, "aad5296d579e34ed71ac6203c03f60eb19e8ca1e"}}},
    {gakudan, {git, "https://github.com/Taure/gakudan.git", {tag, "v0.1.30"}}},
    {gakudan_tickets, {git, "https://github.com/Taure/gakudan_tickets.git", {tag, "v0.1.0"}}},
    {gakudan_tickets_github,
        {git, "https://github.com/Taure/gakudan_tickets_github.git", {tag, "v0.1.2"}}},
    {gakudan_metrics, {git, "https://github.com/Taure/gakudan_metrics.git", {tag, "v0.1.2"}}},
    %% live dashboard for the triage runs
    {gakudan_liveboard, {git, "https://github.com/Taure/gakudan_liveboard.git", {tag, "v0.1.0"}}},
    {datastar,
        {git, "https://github.com/Taure/datastar.git",
            {ref, "fcc11f399294b305620a7c99ed633b898ce3889b"}}},
    {telemetry, "1.4.2"},
    {nova_auth_oidc, {git, "https://github.com/novaframework/nova_auth_oidc.git", {tag, "v0.1.0"}}},
    %% nova_auth (Hex 0.1.1, and novaframework main) still ships the
    %% nova_auth_oidc/_jwt modules extracted into nova_auth_oidc, so both apps
    %% define them -> duplicate-module errors (relx + dialyzer). This fork drops
    %% the stale copies; pinned to a SHA. Upstream fix: novaframework/nova_auth#11
    %% - swap back to Hex once it merges + releases.
    {nova_auth,
        {git, "https://github.com/Taure/nova_auth.git",
            {ref, "1e3423f44a936f3060d863f3241352d58d95b46b"}}}
]}.

{relx, [
    {release, {triagebot, git}, [
        triagebot,
        sasl
    ]},
    {mode, dev},
    {sys_config_src, "./config/dev_sys.config.src"},
    {vm_args_src, "./config/vm.args.src"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {sys_config_src, "./config/prod_sys.config.src"}
        ]}
    ]},
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {deps, []}
    ]}
]}.

{overrides, [
    {override, prometheus, [{erl_opts, [debug_info]}]},
    {override, prometheus_cowboy, [{erl_opts, [debug_info]}]},
    {override, prometheus_httpd, [{erl_opts, [debug_info]}]},
    %% gakudan pulls kura (checkpointer); kura's pre-compile migration hook
    %% crashes when built as a dependency here. We don't run migrations.
    {override, gakudan, [{provider_hooks, []}]}
]}.

{project_plugins, [
    erlfmt,
    rebar3_lint,
    rebar3_hank,
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git", {branch, "feat/include-otp-components"}}},
    covertool
]}.

{erlfmt, [write]}.

{hank, [
    {ignore, [
        "test/**",
        {"src/controllers/triagebot_health_controller.erl", [unnecessary_function_arguments]}
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, unmatched_returns, unknown]},
    {plt_apps, all_deps}
]}.

{xref_checks, [undefined_function_calls, undefined_functions]}.

{ct_opts, [{dir, "test"}]}.

{cover_enabled, true}.
